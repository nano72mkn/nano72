---
import PortfolioLayout from '../layouts/PortfolioLayout.astro';
import Header from '../components/portfolio/Header.astro';
import Footer from '../components/portfolio/Footer.astro';

const timeline = [
  {
    year: '2025',
    title: 'ナノナツとして開業',
    description: '7月2日に個人事業主として開業。スマートフォンアプリ開発を本格的に開始。'
  },
  {
    year: '2025',
    title: 'Habit Tap開発・リリース',
    description: '習慣化サポートアプリ「Habit Tap」をiOS向けにリリース。'
  }
];

const companyInfo = [
  { label: '屋号', value: 'nano72（読み：ナノナツ）' },
  { label: '代表者', value: '宮平 将汰' },
  { label: '所在地', value: '〒150-0041 東京都渋谷区神南１丁目１１−４ ＦＰＧリンクス神南 5階' },
  { label: '開業日', value: '2025年7月2日' },
  { label: '事業内容', value: 'スマートフォン向けアプリケーションの企画・開発・運営' },
  { label: '連絡先', value: 'contact@nano72.com' },
  { label: 'ウェブサイト', value: 'https://nano72.com' },
];
---

<PortfolioLayout 
  title="About - ナノナツ" 
  description="ナノナツの自己紹介と開発理念"
>
  <Header />
  
  <main class="flex-1">
    <!-- ページヘッダー -->
    <section class="py-16 md:py-20 bg-sub-base">
      <div class="max-w-container mx-auto px-6 text-center">
        <h1 class="text-3xl md:text-4xl font-bold font-display text-text-primary mb-4 animate-fadeIn">
          About
        </h1>
        <p class="text-lg text-text-secondary animate-fadeIn" style="animation-delay: 0.1s">
          ナノナツについて
        </p>
      </div>
    </section>
    
    <!-- 自己紹介セクション -->
    <section class="py-20">
      <div class="max-w-container mx-auto px-6">
        <div class="grid md:grid-cols-2 gap-12 items-center">
          <!-- テキスト -->
          <div class="space-y-6">
            <h2 class="text-2xl md:text-3xl font-bold font-display text-text-primary">
              はじめまして、ナノナツです
            </h2>
            <p class="text-text-secondary leading-relaxed">
              ナノナツという屋号で、スマートフォンアプリの個人開発を行っています。
            </p>
            <p class="text-text-secondary leading-relaxed">
              「小さい夏」という意味を込めた名前の通り、夏休みの自由研究のように、作りたいもの、欲しいものを自由に作って、それでいてみんながほっこりするようなアプリをお届けすることを目指しています。
            </p>
            <p class="text-text-secondary leading-relaxed">
              シンプルで使いやすく、それでいて心に残る。そんなアプリケーションを通じて、ユーザーの皆様の毎日が少しでも豊かになることを願っています。
            </p>
          </div>
          
          <!-- イメージ -->
          <div class="relative">
            <div class="aspect-square bg-gradient-to-br from-accent-light to-white rounded-2xl flex items-center justify-center">
              <img 
                src="/logo.png" 
                alt="ナノナツロゴ" 
                class="w-32 h-32 opacity-50"
              />
            </div>
            <!-- 装飾 -->
            <div class="absolute -bottom-4 -right-4 w-24 h-24 bg-accent/10 rounded-full -z-10"></div>
            <div class="absolute -top-4 -left-4 w-32 h-32 bg-accent/5 rounded-full -z-10"></div>
          </div>
        </div>
      </div>
    </section>
    
    <!-- 開発理念セクション -->
    <section class="py-20 bg-sub-base">
      <div class="max-w-container mx-auto px-6">
        <h2 class="text-2xl md:text-3xl font-bold font-display text-text-primary mb-12 text-center">
          開発理念
        </h2>
        
        <div class="grid md:grid-cols-3 gap-8 max-w-4xl mx-auto">
          <div class="text-center">
            <div class="text-4xl mb-4">🌻</div>
            <h3 class="text-xl font-semibold font-display text-text-primary mb-3">自由な発想</h3>
            <p class="text-sm text-text-secondary">
              夏休みの自由研究のように、作りたいものを素直に形にします
            </p>
          </div>
          <div class="text-center">
            <div class="text-4xl mb-4">❤️</div>
            <h3 class="text-xl font-semibold font-display text-text-primary mb-3">温かみ</h3>
            <p class="text-sm text-text-secondary">
              使う人がほっこりする、心に寄り添うアプリを作ります
            </p>
          </div>
          <div class="text-center">
            <div class="text-4xl mb-4">🎐</div>
            <h3 class="text-xl font-semibold font-display text-text-primary mb-3">日常の彩り</h3>
            <p class="text-sm text-text-secondary">
              毎日の生活に小さな楽しみと豊かさを添えます
            </p>
          </div>
        </div>
      </div>
    </section>
    
    <!-- タイムラインセクション -->
    <section class="py-20 bg-sub-base">
      <div class="max-w-container mx-auto px-6">
        <h2 class="text-2xl md:text-3xl font-bold font-display text-text-primary mb-12 text-center">
          あゆみ
        </h2>

        <div class="max-w-2xl mx-auto">
          <div class="relative">
            <!-- 縦線 -->
            <div class="absolute left-8 top-0 bottom-0 w-0.5 bg-border"></div>

            <!-- タイムライン項目 -->
            <div class="space-y-8">
              {timeline.map((item, index) => (
                <div class="relative flex items-start">
                  <!-- ドット -->
                  <div class="absolute left-8 w-4 h-4 bg-accent rounded-full -translate-x-1/2 mt-1.5"></div>

                  <!-- コンテンツ -->
                  <div class="ml-16">
                    <div class="text-sm text-accent font-medium mb-1">{item.year}</div>
                    <h3 class="text-lg font-semibold font-display text-text-primary mb-2">{item.title}</h3>
                    <p class="text-text-secondary text-sm">{item.description}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 事業者情報セクション -->
    <section id="company" class="py-20">
      <div class="max-w-container mx-auto px-6">
        <h2 class="text-2xl md:text-3xl font-bold font-display text-text-primary mb-4 text-center">
          事業者情報
        </h2>
        <p class="text-center text-text-secondary mb-12">
          ナノナツの事業者情報です。
        </p>

        <div class="max-w-3xl mx-auto bg-white rounded-xl shadow-card overflow-hidden">
          <dl class="divide-y divide-border">
            {companyInfo.map(item => (
              <div class="grid grid-cols-1 md:grid-cols-3 gap-2 md:gap-6 px-6 py-5">
                <dt class="text-sm font-semibold font-display text-text-primary md:col-span-1">
                  {item.label}
                </dt>
                <dd class="text-sm text-text-secondary md:col-span-2 break-words">
                  {item.value}
                </dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</PortfolioLayout>